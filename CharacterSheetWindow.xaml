                                                 FontSize="14" FontWeight="Bold" TextAlignment="Center" Padding="2" CaretBrush="{DynamicResource AccentBrush}"
                                                 PreviewTextInput="NumberValidationTextBox"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="РЕПУТАЦИЯ" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Reputation, UpdateSourceTrigger=PropertyChanged}" 
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" 
                                                 FontSize="14" FontWeight="Bold" TextAlignment="Center" Padding="2" CaretBrush="{DynamicResource AccentBrush}"
                                                 PreviewTextInput="NumberValidationTextBox"/>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="0,4"/>

                                <Grid Grid.Column="2" Margin="8,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ПРИОБРЕТЕНИЕ РЕПУТАЦИИ (За что знают)" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding ReputationEvents, UpdateSourceTrigger=PropertyChanged}" 
                                             Foreground="{DynamicResource TextBrush}" FontSize="12" Background="{DynamicResource RaisedBrush}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Padding="4"
                                             TextWrapping="Wrap" AcceptsReturn="True" CaretBrush="{DynamicResource AccentBrush}" VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{DynamicResource Card}" Grid.Row="4">
                            <Grid>
                                <Border Style="{DynamicResource RedHeader}" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0,0,2,2" Panel.ZIndex="1">
                                    <TextBlock Text="ОБРАЗ И СТИЛЬ" Style="{DynamicResource RedHeaderText}" FontSize="11"/>
                                </Border>
                                        <TextBox Text="{Binding StyleNotes, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" FontSize="14" BorderThickness="1" AcceptsReturn="True" TextWrapping="Wrap" Margin="8,24,8,4" CaretBrush="{DynamicResource AccentBrush}" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="35*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{DynamicResource Card}" Grid.Column="0">
                                <Grid>
                                    <Border Style="{DynamicResource RedHeader}" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0,0,2,2" Panel.ZIndex="1">
                                        <TextBlock Text="ЖИЛЬЕ" Style="{DynamicResource RedHeaderText}" FontSize="10"/>
                                    </Border>
                                    <TextBox Text="{Binding Housing, UpdateSourceTrigger=PropertyChanged}" 
                                             Foreground="{DynamicResource TextBrush}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" FontSize="14" 
                                             AcceptsReturn="True" TextWrapping="Wrap" Margin="6,22,6,4" CaretBrush="{DynamicResource AccentBrush}" 
                                             VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>

                            <Border Style="{DynamicResource Card}" Grid.Column="2">
                                <Grid>
                                    <Border Style="{DynamicResource RedHeader}" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0,0,2,2" Panel.ZIndex="1">
                                        <TextBlock Text="АРЕНДНАЯ ПЛАТА" Style="{DynamicResource RedHeaderText}" FontSize="10"/>
                                    </Border>
                                    <TextBox Text="{Binding Rent, UpdateSourceTrigger=PropertyChanged}" 
                                             Foreground="{DynamicResource TextBrush}" FontSize="14" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" 
                                             AcceptsReturn="True" TextWrapping="Wrap" Margin="6,22,6,4" CaretBrush="{DynamicResource AccentBrush}" 
                                             VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>

                            <Border Style="{DynamicResource Card}" Grid.Column="4">
                                <Grid>
                                    <Border Style="{DynamicResource RedHeader}" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="0,0,2,2" Panel.ZIndex="1">
                                        <TextBlock Text="ОБРАЗ ЖИЗНИ" Style="{DynamicResource RedHeaderText}" FontSize="10"/>
                                    </Border>
                                    <TextBox Text="{Binding Lifestyle, UpdateSourceTrigger=PropertyChanged}" 
                                             Foreground="{DynamicResource TextBrush}" FontSize="14" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" 
                                             AcceptsReturn="True" TextWrapping="Wrap" Margin="6,22,6,4" CaretBrush="{DynamicResource AccentBrush}" 
                                             VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="3: КИБЕРИМПЛАНТЫ">
                <Grid Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CyberwareBlocks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Card}" Margin="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Style="{DynamicResource TitleBar}" Grid.Row="0" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsInstalled, Mode=OneWay}" IsHitTestVisible="False" Style="{DynamicResource NeonCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Heavy" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="14"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock Text="ЗАНЯТО:" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding UsedSlots, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="20" Height="18" Background="{DynamicResource BackBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" TextAlignment="Center" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0" CaretBrush="Transparent" Padding="0"/>
                                                    <TextBlock Text="{Binding SlotsText, StringFormat='({0})'}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="4">
                                            <StackPanel>
                                                <TextBox Text="{Binding OptionsText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" CaretBrush="{DynamicResource MutedBrush}" Margin="0,0,0,5" ToolTip="Ручные заметки"/>

                                                <ItemsControl ItemsSource="{Binding InstalledItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,0,4" Padding="4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding TooltipText}" ToolTipService.InitialShowDelay="150" Cursor="Help"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Slots, StringFormat='Слотов: {0}'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="2" Content="X" Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Tag="{Binding}" Click="BtnUninstallCyber_Click" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <Button Grid.Row="2" Content="УПРАВЛЕНИЕ ИМПЛАНТАМИ" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Margin="6,2,6,6" Padding="0,4" Cursor="Hand" FontWeight="Bold" FontSize="11" Tag="{Binding}" Click="BtnOpenCyberwareManager_Click"/>
                                    </Grid>
                                </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

                    <TabItem Header="4: NPC">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{DynamicResource Card}" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ДОБАВЛЕНИЕ NPC" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <ComboBox ItemsSource="{Binding AvailableEnemies}" x:Name="CbNpcSelect" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource LineBrush}" Height="26" Margin="0,0,0,10">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Content="ДОБАВИТЬ В ЛИСТ" Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" Padding="10,5" Margin="0,0,0,10" Cursor="Hand" Click="BtnAddNPC_Click" Tag="{Binding ElementName=CbNpcSelect}"/>
                                    <Button Content="СОЗДАТЬ НОВОГО NPC" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" FontWeight="Bold" Padding="10,5" Cursor="Hand" Click="BtnOpenEnemyManager_Click"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                                <ItemsControl ItemsSource="{Binding NPCs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="10" Background="{DynamicResource RaisedBrush}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource BrightBrush}" FontSize="18" FontWeight="Heavy" BorderThickness="0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding CombatStatsDisplay}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                                            <ItemsControl ItemsSource="{Binding DisplaySkills}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Vertical" MaxHeight="125"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,15,2"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding ActionPenalty, StringFormat='ШТРАФ К ДЕЙСТВИЯМ: -{0}'}" Foreground="{DynamicResource DangerBrush}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" Visibility="{Binding PenaltyVis}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,20,0">
                                                            <TextBlock Text="ЗДОРОВЬЕ (ПЗ)" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                                                <Button Content="+" Background="{DynamicResource DangerBrush}" Foreground="Black" Width="22" Height="22" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="BtnHealNPC_Click"/>
                                                                <TextBox Text="{Binding CurrentHP, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource DangerBrush}" FontSize="20" FontWeight="Bold" BorderThickness="0" TextAlignment="Center" Width="38"/>
                                                                <TextBlock Text="/" Foreground="{DynamicResource MutedBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0"/>
                                                                <TextBox Text="{Binding MaxHP, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource MutedBrush}" FontSize="20" FontWeight="Bold" BorderThickness="0" TextAlignment="Center" Width="38"/>
                                                                <Button Content="-" Background="{DynamicResource DangerBrush}" Foreground="Black" Width="22" Height="22" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="BtnDamageNPC_Click"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,0,20,0">
                                                            <TextBlock Text="ОС (ГОЛОВА)" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                                                                <TextBox Text="{Binding HeadArmor, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource BrightBrush}" FontSize="20" FontWeight="Bold" BorderThickness="0" TextAlignment="Center" Width="35"/>
                                                                <Button Content="-1 ОС" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Padding="6,2" FontWeight="Bold" Cursor="Hand" Tag="{Binding}" Click="BtnAblateHeadNPC_Click"/>
                                                            </StackPanel>
                                                            <TextBlock Text="ОС (ТЕЛО)" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <TextBox Text="{Binding BodyArmor, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource BrightBrush}" FontSize="20" FontWeight="Bold" BorderThickness="0" TextAlignment="Center" Width="35"/>
                                                                <Button Content="-1 ОС" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Padding="6,2" FontWeight="Bold" Cursor="Hand" Tag="{Binding}" Click="BtnAblateBodyNPC_Click"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Content="X" Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" FontWeight="Bold" FontSize="20" Cursor="Hand" VerticalAlignment="Top" Tag="{Binding}" Click="BtnRemoveNPC_Click"/>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                            <TextBlock Text="ОРУЖИЕ:" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                            <TextBox Text="{Binding Weapons, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BackBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="4" TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                                            <TextBlock Text="СНАРЯЖЕНИЕ / БРОНЯ:" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                            <TextBox Text="{Binding Gear, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BackBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="4" TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                                            <TextBlock Text="КИБЕРИМПЛАНТЫ:" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                                            <ScrollViewer Height="70" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="2">
                                                                <ItemsControl ItemsSource="{Binding ParsedCyberware}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Style="{DynamicResource SectionHeader}" Margin="0,0,0,4" Padding="4" ToolTip="{Binding TooltipText}" ToolTipService.InitialShowDelay="150" Cursor="Help">
                                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="NetTab" Header="5: НЕТРАННИНГ"/>
                </TabControl>

        <StackPanel x:Name="TopBar" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,0,5,0">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}" Margin="0,0,14,0" Padding="6,0" VerticalAlignment="Center" Height="38">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" Foreground="{DynamicResource DangerBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSkillSearch" Width="140" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" CaretBrush="{DynamicResource AccentBrush}" FontSize="14" VerticalAlignment="Center" TextChanged="TxtSkillSearch_TextChanged" ToolTip="Подсвечивает подходящие навыки, остальные тускнеют"/>
                </StackPanel>
            </Border>
            <Button x:Name="BtnUndo" Style="{DynamicResource TopBarBtn}" Content="↶" FontSize="18" Foreground="{DynamicResource WarnBrush}" BorderBrush="{DynamicResource WarnBrush}" Click="BtnUndo_Click" ToolTip="Отменить последнее изменение (Ctrl+Z)"/>
            <Button x:Name="BtnRedo" Style="{DynamicResource TopBarBtn}" Content="↷" FontSize="18" Foreground="{DynamicResource WarnBrush}" BorderBrush="{DynamicResource WarnBrush}" Click="BtnRedo_Click" ToolTip="Вернуть отменённое (Ctrl+Y)"/>
            <Button x:Name="BtnImprove" Style="{DynamicResource TopBarBtn}" Content="⬆ ПРОКАЧКА" Click="BtnImprove_Click" ToolTip="Потратить очки улучшения на навыки и роли"/>
            <Button x:Name="BtnMenu" Style="{DynamicResource TopBarBtn}" Content="☰ МЕНЮ" Click="BtnMenu_Click" ToolTip="Финансы, экспорт в PDF, печать, настройки"/>
            <Button Cursor="Hand" Margin="0,0,10,0" Click="BtnSaveChanges_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,2,2,0" Padding="25,12">
                            <TextBlock Text="СОХРАНИТЬ" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Cursor="Hand" Click="BtnBackToMenu_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2,2,2,0" Padding="25,12">
                            <TextBlock Text="ЗАКРЫТЬ ДОСЬЕ" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        <Border x:Name="CyberwareOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" Panel.ZIndex="100" Margin="-15,-10,-15,-5">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" Width="950" Height="700" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource TitleBar}" Grid.Row="0" Padding="15,0">
                        <Grid>
                            <TextBlock Text="{Binding OverlayTitle}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Heavy" FontSize="16" VerticalAlignment="Center"/>
                            <Button Content="X" Foreground="{DynamicResource OnAccentBrush}" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="BtnCloseCyberwareManager_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="ДОСТУПНЫЕ ИМПЛАНТЫ" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="   ПОИСК: " Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtCyberSearch" Width="220" Background="{DynamicResource BackBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource LineBrush}" CaretBrush="{DynamicResource AccentBrush}" FontSize="13" Padding="3" VerticalAlignment="Center" TextChanged="TxtCyberSearch_TextChanged"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AvailableCyberware}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,0,5" Padding="5" ToolTip="{Binding TooltipText}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrightBrush}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding HumanityLoss, StringFormat='ПЧ: {0}'}" Foreground="{DynamicResource DangerBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Slots, StringFormat='Слотов: {0}'}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="X" Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Padding="5" Cursor="Hand" FontWeight="Bold" FontSize="14" Tag="{Binding}" Click="BtnDeleteCustomCyber_Click">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="УСТАНОВИТЬ" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="10,5" Cursor="Hand" Tag="{Binding}" Click="BtnInstallCyber_Click" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

