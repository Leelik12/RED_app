                                            <Button Content="СОХРАНИТЬ ПРЕСЕТ В БАЗУ" Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Heavy" FontSize="14" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="BtnSaveNewEnemy_Click"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
            <!-- шапка детального стиля: портрет, имя, шкалы ПЗ / брони / человечности и сводка -->
            <Border x:Name="HudBar" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Top" Height="50" Margin="10,3,15,0" Style="{DynamicResource HudPanel}">
                <Grid Margin="14,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" MinWidth="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HudPortrait" Width="40" Height="40" CornerRadius="20" BorderThickness="2" BorderBrush="{DynamicResource DangerBrush}" Background="{DynamicResource RaisedBrush}" Margin="0,0,14,0">
                        <TextBlock x:Name="HudGlyph" Text="👤" FontSize="20" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Role}" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding WoundStateText}" Foreground="{DynamicResource WarnBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="ПУНКТЫ ЗДОРОВЬЯ" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                            </DockPanel>
                            <Grid Margin="0,3,0,0">
                                <ProgressBar Style="{StaticResource GlowBar}" Foreground="{DynamicResource DangerBrush}" Maximum="{Binding MaxHP, Converter={StaticResource AtLeastOne}}" Value="{Binding CurrentHP, Mode=OneWay}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentHP}" Foreground="{DynamicResource BrightBrush}" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MaxHP, StringFormat=' / {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="ОС: ГОЛОВА  ·  ТЕЛО" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                <Grid Margin="0,0,3,0">
                                    <ProgressBar Style="{StaticResource GlowBar}" Foreground="{DynamicResource WarnBrush}" Maximum="{Binding Armor.HeadSpMax, Converter={StaticResource AtLeastOne}}" Value="{Binding Armor.HeadSpCurrent, Mode=OneWay}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Armor.HeadSpCurrent}" Foreground="{DynamicResource BrightBrush}" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Armor.HeadSpMax, StringFormat=' / {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="3,0,0,0">
                                    <ProgressBar Style="{StaticResource GlowBar}" Foreground="{DynamicResource WarnBrush}" Maximum="{Binding Armor.BodySpMax, Converter={StaticResource AtLeastOne}}" Value="{Binding Armor.BodySpCurrent, Mode=OneWay}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Armor.BodySpCurrent}" Foreground="{DynamicResource BrightBrush}" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Armor.BodySpMax, StringFormat=' / {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ЧЕЛОВЕЧНОСТЬ" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <Grid Margin="0,2,0,0">
                                <ProgressBar Style="{StaticResource GlowBar}" Foreground="{DynamicResource AccentBrush}" Maximum="{Binding MaxHumanity, Converter={StaticResource AtLeastOne}}" Value="{Binding CurrentHumanity, Mode=OneWay}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentHumanity}" Foreground="{DynamicResource BrightBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MaxHumanity, StringFormat=' / {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Style="{DynamicResource HudChip}" ToolTip="Очки улучшения">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ОУ" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ImprovementPoints}" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource HudChip}" ToolTip="Репутация">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="РЕП" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Reputation}" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource HudChip}" ToolTip="Наличные">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="eb" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CashValue}" Foreground="{DynamicResource WarnBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- мини-лист: ключевые показатели видны на любой вкладке, кроме основной -->
            <Border x:Name="MiniSheet" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="200" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,18"
                    Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="MiniPortrait" Width="40" Height="40" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <TextBlock Text="ПЗ" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CurrentHP}" Foreground="{DynamicResource DangerBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MaxHP, StringFormat=' / {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding WoundStateText}" Foreground="{DynamicResource WarnBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <TextBlock Text="ОС" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Armor.HeadSpCurrent, StringFormat='голова {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Armor.BodySpCurrent, StringFormat='тело {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <TextBlock Text="ЧЕЛ" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CurrentHumanity}" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MaxHumanity, StringFormat=' / {0}'}" Foreground="{DynamicResource BrightBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border x:Name="RollToast" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="250" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" IsHitTestVisible="False"
                    Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Padding="22,12">
                <TextBlock x:Name="RollToastText" Foreground="{DynamicResource BrightBrush}" FontSize="22" FontWeight="Bold"/>
            </Border>
            <Grid x:Name="NavLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="300">
                <Border Background="{DynamicResource OverlayBrush}" MouseDown="NavScrim_Click"/>
                <Border x:Name="NavDrawer" Width="440" HorizontalAlignment="Left" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="0,0,2,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavSlide" X="-440"/>
                    </Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavList" Margin="22,26,22,22"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>