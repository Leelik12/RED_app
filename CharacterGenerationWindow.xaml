<Window x:Class="CyberpunkRED_Generator.CharacterGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ТЕРМИНАЛ: Создание персонажа" Height="1080" Width="1920" Background="{DynamicResource BackBrush}" WindowState="Maximized" WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource UiFont}">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource BackBrush}"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource AccentDarkBrush}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,8"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource DangerColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource OnAccentColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource DangerColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource OnAccentColor}"/>
            </Style.Resources>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path x:Name="Arrow" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 5 5 L 10 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" Margin="10,8,30,8" VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Margin="8,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{DynamicResource UiFont}" CaretBrush="{TemplateBinding Foreground}"/>

                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <Border Background="{DynamicResource BackBrush}" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" FontSize="14" FontFamily="{DynamicResource UiFont}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <DataTemplate x:Key="SkillCategoryTemplate">
            <StackPanel Margin="0,0,0,25">

                <Border Background="{DynamicResource DangerBrush}" Padding="10,5" Margin="0,0,0,5">
                    <TextBlock Text="{Binding CategoryName}" Foreground="{DynamicResource OnAccentBrush}" FontSize="16" FontWeight="Heavy"/>
                </Border>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="НАВЫК" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" Text="СТАТ" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="УРОВЕНЬ" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="СУММА" Foreground="{DynamicResource AccentDarkBrush}" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Skills}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,5" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <Button Content="X" Style="{StaticResource SmallBtn}" Width="20" Height="20" Margin="0,0,5,0"
                                                Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" FontSize="12"
                                                Visibility="{Binding RemoveBtnVis}" Tag="{Binding}" Click="BtnRemoveVariant_Click"/>

                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center" 
                                                   Visibility="{Binding BaseNameVis}" ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="15000"/>

                                        <TextBlock Text="{Binding BaseName, StringFormat='{}{0}: '}" Foreground="{DynamicResource TextBrush}" FontSize="14" VerticalAlignment="Center" 
                                                   Visibility="{Binding BaseVariantLabelVis}" ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="15000"/>

                                        <TextBox Text="{Binding SubName, UpdateSourceTrigger=PropertyChanged}" 
                                                 Visibility="{Binding SubNameVis}"
                                                 Margin="4,0,0,0" Width="100" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource AccentDarkBrush}" BorderBrush="{DynamicResource AccentDarkBrush}" BorderThickness="1"
                                                 Padding="2" VerticalAlignment="Center" FontFamily="{DynamicResource UiFont}"/>

                                        <Button Content="+" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" 
                                                Visibility="{Binding AddBtnVis}" Tag="{Binding}" Click="BtnAddVariant_Click" 
                                                Margin="6,0,0,0" Padding="0" Cursor="Hand" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding StatName}" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center" TextAlignment="Center"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding NormalControlsVisibility}">
                                        <Button Content="-" Style="{StaticResource SmallBtn}" Tag="{Binding}" Click="SkillBtnMinus_Click"/>
                                        <TextBlock Text="{Binding Level}" Width="35" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrightBrush}" FontSize="18"/>
                                        <Button Content="+" Style="{StaticResource SmallBtn}" Tag="{Binding}" Click="SkillBtnPlus_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding Total}" Foreground="{DynamicResource AccentDarkBrush}" FontSize="20" TextAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding NormalControlsVisibility}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080">
            <Grid>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentDarkBrush}" BorderThickness="0,0,0,2" VerticalAlignment="Top" Height="60" Padding="20,0">
            <TextBlock x:Name="TxtProgress" Text="ЭТАП 1: ХАРАКТЕРИСТИКИ" Foreground="{DynamicResource AccentDarkBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <TabControl x:Name="WizardTabControl" Background="Transparent" BorderThickness="0" Margin="0,60,0,0" SelectionChanged="WizardTabControl_SelectionChanged">

            <TabItem>
                <Grid Margin="20">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                        <Style x:Key="StatName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Width" Value="60"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="18"/>
                        </Style>
                        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource BrightBrush}"/>
                            <Setter Property="Width" Value="40"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="24"/>
                        </Style>
                        <Style x:Key="StatBtn" TargetType="Button">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="18"/>
                        </Style>
                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" Background="{DynamicResource PanelBrush}" Padding="20" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="ИНТЕРФЕЙС ГЕНЕРАЦИИ :: СТАТЫ" FontSize="22" Margin="0,0,0,20"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="ИМЯ ПЕРСОНАЖА:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <TextBox x:Name="TxtCharName" Width="300" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource BrightBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" FontSize="16" FontWeight="Bold" Padding="8,5" CaretBrush="{DynamicResource AccentDarkBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <RadioButton x:Name="RbCalc" Content="Ручная настройка" Foreground="{DynamicResource BrightBrush}" FontSize="16" FontWeight="Bold" IsChecked="True" Checked="ModeChanged" Margin="0,0,20,0"/>
                                <RadioButton x:Name="RbRandom" Content="Полный рандом" Foreground="{DynamicResource BrightBrush}" FontSize="16" FontWeight="Bold" Checked="ModeChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCalc" Margin="0,0,0,20">
                                <TextBlock Text="ДОПУСК (ПУЛ ОЧКОВ):" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CbRank" SelectionChanged="CbRank_SelectionChanged" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource AccentBrush}" Padding="8">
                                    <ComboBoxItem Content="Второстепенный персонаж (50)" Tag="50"/>
                                    <ComboBoxItem Content="Стандартный персонаж (62)" IsSelected="True" Tag="62"/>
                                    <ComboBoxItem Content="Главная роль 2-го плана (70)" Tag="70"/>
                                    <ComboBoxItem Content="Второстепенный герой (75)" Tag="75"/>
                                    <ComboBoxItem Content="Главный герой (80)" Tag="80"/>
                                </ComboBox>
                                <TextBlock FontSize="18" Margin="0,15,0,0">
                                    <Run Text="ДОСТУПНО ОЧКОВ: " Foreground="{DynamicResource BrightBrush}"/>
                                    <Run x:Name="TxtPointsLeft" Text="62" Foreground="{DynamicResource AccentBrush}" FontSize="22"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel x:Name="PanelRandom" Visibility="Collapsed" Margin="0,0,0,20">
                                <Button Content="ЗАПУСК АЛГОРИТМА 3D4" Style="{StaticResource CyberButton}" Click="BtnRollStats_Click" Margin="0,0,0,10"/>
                                <TextBlock Text="Система сгенерирует значения от 2 до 8." Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                            </StackPanel>

                            <UniformGrid x:Name="StatsGrid" Columns="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="ИНТ:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtInt" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtInt" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtInt" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="РЕА:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtRef" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtRef" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtRef" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="ЛВК:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtDex" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtDex" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtDex" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="ТЕХ:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtTech" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtTech" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtTech" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="ХАР:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtCool" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtCool" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtCool" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="ВОЛЯ:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtWill" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtWill" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtWill" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="УДЧ:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtLuck" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtLuck" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtLuck" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="СКО:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtMove" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtMove" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtMove" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="ТЕЛ:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtBody" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtBody" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtBody" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,8">
                                    <TextBlock Text="ЭМП:" Style="{StaticResource StatName}"/>
                                    <Button Content="-" Style="{StaticResource StatBtn}" Tag="TxtEmp" Click="StatBtnMinus_Click"/>
                                    <TextBlock x:Name="TxtEmp" Text="2" Style="{StaticResource StatValue}"/>
                                    <Button Content="+" Style="{StaticResource StatBtn}" Tag="TxtEmp" Click="StatBtnPlus_Click"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="18">
                                <Run Text="ОБЩАЯ СУММА СТАТОВ: " Foreground="{DynamicResource MutedBrush}"/>
                                <Run x:Name="TxtTotalStats" Text="20" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="24"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Background="{DynamicResource PanelBrush}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="СИСТЕМНЫЕ ПОКАЗАТЕЛИ" Foreground="{DynamicResource AccentBrush}" FontSize="20" Margin="0,0,0,20"/>
                                <Grid Margin="0,12">
                                    <TextBlock Text="ПЗ (Hit Points):" Foreground="{DynamicResource BrightBrush}"/>
                                    <TextBlock x:Name="TxtHp" Text="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="20"/>
                                </Grid>
                                <Grid Margin="0,12">
                                    <TextBlock Text="Порог тяж. ранения:" Foreground="{DynamicResource BrightBrush}"/>
                                    <TextBlock x:Name="TxtWounded" Text="5" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" FontSize="20"/>
                                </Grid>
                                <Grid Margin="0,12">
                                    <TextBlock Text="Спасбросок смерти:" Foreground="{DynamicResource BrightBrush}"/>
                                    <TextBlock x:Name="TxtDeathSave" Text="2" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="20"/>
                                </Grid>
                                <Grid Margin="0,12">
                                    <TextBlock Text="Человечность (ЧЕЛ):" Foreground="{DynamicResource BrightBrush}"/>
                                    <TextBlock x:Name="TxtHumanity" Text="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="20"/>
                                </Grid>
                            </StackPanel>
                            <Button Grid.Row="1" Content="ПРОДОЛЖИТЬ [ЖИЗНЕННЫЙ ПУТЬ]" Style="{StaticResource CyberButton}" Click="BtnNextStep_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <Grid Margin="20">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2" Background="{DynamicResource BackBrush}" Padding="20" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="ИНТЕРФЕЙС ГЕНЕРАЦИИ :: ЖИЗНЕННЫЙ ПУТЬ" FontSize="22" Margin="0,0,0,20"/>
                            <Button Grid.Row="1" Content="АЛГОРИТМ РАНДОМА (БРОСОК 1D10)" Style="{StaticResource CyberButton}" Click="BtnLifepathRandom_Click" Margin="0,0,0,20"/>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                        <StackPanel Margin="0,0,15,0" TextBoxBase.TextChanged="UpdateLifepathLog">
                                    <TextBlock Text="Культурное происхождение:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CbOrigin" SelectionChanged="UpdateLifepathLog" IsEditable="True"  />
                                    <TextBlock Text="Личность:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CbPersonality" SelectionChanged="UpdateLifepathLog" IsEditable="True"  />
                                    <TextBlock Text="Стиль одежды:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CbClothing" SelectionChanged="UpdateLifepathLog" IsEditable="True"  />
                                    <TextBlock Text="Прическа:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CbHair" SelectionChanged="UpdateLifepathLog" IsEditable="True"  />
                                    <TextBlock Text="Особенность:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CbFeature" SelectionChanged="UpdateLifepathLog" IsEditable="True"  />
                                    <TextBlock Text="Что ты ценишь больше всего:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CbValue" SelectionChanged="UpdateLifepathLog" IsEditable="True"  />
                                    <TextBlock Text="Как ты относишься к людям:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CbPeople" SelectionChanged="UpdateLifepathLog" IsEditable="True"  />
                                    <TextBlock Text="Самый ценный человек:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
