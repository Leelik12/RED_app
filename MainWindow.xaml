<Window x:Class="CyberpunkRED_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyberpunk RED - Главное меню" Height="640" Width="980" MinHeight="560" MinWidth="820"
        Background="{DynamicResource BackBrush}" WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource UiFont}">

    <Window.Resources>
        <Style x:Key="MenuCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,3" Padding="22,16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="48,34,48,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="CYBERPUNK RED" Foreground="{DynamicResource DangerBrush}" FontSize="52" FontWeight="Heavy">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource DangerColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                </TextBlock.Effect>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                <TextBlock Text="ТЕРМИНАЛ ЭДЖРАННЕРА" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource MutedBrush}" FontSize="16" Margin="16,0,0,0"/>
            </StackPanel>
            <Border Height="2" Background="{DynamicResource DangerBrush}" Margin="0,16,0,0" HorizontalAlignment="Left" Width="140"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Button Style="{StaticResource MenuCard}" Click="BtnGenerate_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧬" FontSize="34" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ГЕНЕРАЦИЯ ПЕРСОНАЖА" Foreground="{DynamicResource AccentBrush}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Роль, жизненный путь, навыки, снаряжение — по правилам книги." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuCard}" Click="BtnLoadCharacter_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="34" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ЛИСТ ПЕРСОНАЖА" Foreground="{DynamicResource AccentBrush}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Открыть сохранённого персонажа: бой, киберимпланты, нетраннинг, финансы." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuCard}" Click="BtnOpenGMScreen_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎭" FontSize="34" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ЭКРАН ГЕЙМ-МАСТЕРА" Foreground="{DynamicResource AccentBrush}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Бой, инициатива, враги, погода, погони и ночные рынки в одном окне." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource MenuLink}" Content="⚙ Настройки и тема" Click="BtnSettings_Click"/>
            <Button Style="{StaticResource MenuLink}" Content="📜 Правила" Click="BtnRules_Click"/>
            <Button Style="{StaticResource MenuLink}" Content="🔄 Проверить обновления" Click="BtnUpdates_Click"/>
            <Button Style="{StaticResource MenuLink}" Content="ℹ О программе" Click="BtnAbout_Click"/>
        </StackPanel>
    </Grid>
</Window>
